{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aesopkernel",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "routes": [
    { "pattern": "aesopkernel.ai", "custom_domain": true },
    { "pattern": "www.aesopkernel.ai", "custom_domain": true }
  ]
}
